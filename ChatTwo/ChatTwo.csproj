<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>1.41.2</Version>
        <AssemblyVersion>1.41.3.0</AssemblyVersion>
        <FileVersion>1.41.3.0</FileVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- DLL 文件名须匹配卫月的 InternalName（ChatTwoCN）才能从插件库安装 -->
        <AssemblyName>ChatTwoCN</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.7" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
        <!-- 迁移原版 ChatTwo 配置必需：原版 ChatTwo.json 由 Dalamud 用 Newtonsoft+$type 保存（字体 IFontId 接口），System.Text.Json 读必崩 -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="morelinq" Version="4.4.0" />
        <PackageReference Include="Pidgin" Version="3.3.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Watson.Lite" Version="6.3.9" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Language.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Language.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Language.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Language.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <!-- 原生 UI 图标（FFXIV circlebuttons_hr1 切出，作为插件嵌入资源分发）。 -->
    <!-- 资源 ID = "ChatTwo.images.&lt;filename&gt;.png"（RootNamespace=ChatTwo；⚠️ 不是 ChatTwoCN）。 -->
    <ItemGroup>
        <EmbeddedResource Include="images\toolbar_chatsearch.png" />
        <EmbeddedResource Include="images\toolbar_searchgo.png" />
        <EmbeddedResource Include="images\toolbar_players.png" />
        <EmbeddedResource Include="images\toolbar_close.png" />
        <EmbeddedResource Include="images\toolbar_gear.png" />
        <EmbeddedResource Include="images\toolbar_funnel.png" />
        <EmbeddedResource Include="images\toolbar_bubble.png" />
        <EmbeddedResource Include="images\toolbar_plus.png" />
        <EmbeddedResource Include="images\toolbar_leaf.png" />
        <EmbeddedResource Include="images\toolbar_tab_cap_left.png" />
        <EmbeddedResource Include="images\toolbar_tab_middle.png" />
        <EmbeddedResource Include="images\toolbar_tab_cap_right.png" />
        <EmbeddedResource Include="images\toolbar_tab_divider.png" />
        <EmbeddedResource Include="images\toolbar_tab_indicator.png" />
        <EmbeddedResource Include="images\toolbar_resize_handle_normal.png" />
        <EmbeddedResource Include="images\toolbar_resize_handle_highlighted.png" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="images\" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="ChatTwoCN.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
